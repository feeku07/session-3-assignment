  "item": [
    {
      "name": "GET - List Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Response time below 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));\r",
              "pm.test(\"Response has data array\", () => {\r",
              "    pm.expect(pm.response.json().data).to.be.an('array');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users?page=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET - Single User (Positive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Response has correct id\", () => {\r",
              "    pm.expect(pm.response.json().data.id).to.eql(2);\r",
              "});\r",
              "pm.test(\"Response has email field\", () => {\r",
              "    pm.expect(pm.response.json().data).to.have.property('email');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "2"
          ]
        }
      },
      "response": []
    },
