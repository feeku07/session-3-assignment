    {
      "name": "POST - Create User (Positive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));\r",
              "pm.test(\"Response has id and createdAt\", () => {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property('id');\r",
              "    pm.expect(json).to.have.property('createdAt');\r",
              "});\r",
              "pm.test(\"Name matches request\", () => {\r",
              "    pm.expect(pm.response.json().name).to.eql(\"Fakhra\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Fakhra\",\r\n    \"job\": \"QA Intern\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
