      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));\r",
              "pm.test(\"Response body is empty object\", () => {\r",
              "    pm.expect(pm.response.json()).to.eql({});\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
